{
  "name": "encore",
  "productName": "Vyse Music",
  "version": "0.8.0",
  "private": true,
  "description": "Vyse Music: a free, ad-free desktop music player. Your music from everywhere, in one place.",
  "license": "MIT",
  "homepage": "https://github.com/Sameer786op/encore",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sameer786op/encore.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win",
    "probe": "node scripts/probe-youtube.mjs",
    "smoke": "node scripts/smoke.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "smoke:imports": "node scripts/smoke-imports.mjs",
    "smoke:player": "node scripts/smoke-player.mjs",
    "smoke:feed": "node scripts/smoke-feed.mjs",
    "release": "node scripts/release.mjs",
    "dist:store": "node scripts/dist-store.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "googlevideo": "^5.0.1",
    "music-metadata": "^12.2.2",
    "yauzl": "^3.4.0",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.61.0",
    "motion": "^12.43.0",
    "playwright-core": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "author": "Encore contributors"
}
